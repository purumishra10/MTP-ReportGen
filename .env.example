# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (optional)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Supabase — Project Settings → API
# URL must be https://xxxx.supabase.co  (no /rest/v1 suffix)
SUPABASE_URL=https://your-project.supabase.co
# Publishable / anon key (optional if service role is set)
SUPABASE_KEY=your_anon_or_publishable_key_here
# Required for the FastAPI backend (bypasses RLS).
# Settings → API Keys → Secret key (sb_secret_...)  OR  Legacy API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_here
